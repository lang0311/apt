#!/bin/sh
# 커밋 전 키·비밀 값 검사 (레포가 public이라 커밋되면 바로 노출된다)
# 설치: cp tools/hooks/pre-commit .git/hooks/pre-commit
# 오탐이면 해당 줄을 고치거나 값을 config/dev.json 등 gitignore 대상으로 옮긴다. --no-verify로 넘기지 않는다.

fail=0

# 1) 올리면 안 되는 파일
files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)|\.jks$|\.keystore$|(^|/)key\.properties$|(^|/)config/dev\.json$|Secrets\.xcconfig$|(^|/)local\.properties$' | grep -vE '\.example($|\.)')
if [ -n "$files" ]; then
  echo "[pre-commit] 커밋하면 안 되는 파일이 스테이징돼 있어요:"
  echo "$files" | sed 's/^/  /'
  fail=1
fi

# 2) 추가되는 줄에 키 형식이 있는지 (값은 출력하지 않고 파일·줄 위치만 보여 준다)
pattern='sk-or-v1-[0-9a-f]{20,}|sk-ant-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{35}|gh[pousr]_[A-Za-z0-9]{30,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|(API_KEY|APP_KEY|SECRET|CLIENT_ID|PASSWORD|TOKEN)["'"'"']?[[:space:]]*[=:][[:space:]]*["'"'"']?[A-Za-z0-9_-]{8,}'
hits=$(git diff --cached -U0 --diff-filter=ACMR --no-color | awk -v pat="$pattern" '
  /^\+\+\+ / { file = substr($0, 7); next }
  /^@@/ { split($3, a, ","); line = substr(a[1], 2) + 0; next }
  /^\+/ { if (substr($0, 2) ~ pat) print "  " file ":" line; line++ }
')
if [ -n "$hits" ]; then
  echo "[pre-commit] 키로 보이는 값이 있어요:"
  echo "$hits"
  fail=1
fi

if [ $fail -ne 0 ]; then
  echo "[pre-commit] 커밋을 멈췄어요. 값을 빼고 다시 커밋해 주세요."
  exit 1
fi
exit 0
